# Offline works without credentials. Never commit your real .env.
PROVIDER=offline
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
STATE_DIR=var
# Empty = local SQLite checkpointer. Optional Postgres URL requires uv sync --extra postgres.
CHECKPOINT_URL=
# Set before exposing outside your own computer; clients send X-API-Key.
API_KEY=
MAX_TOOL_CALLS=12
MODEL_TIMEOUT_SECONDS=30
INCIDENT_TIMEOUT_SECONDS=120
MAX_TOKENS_PER_INCIDENT=40000
# Optional. Supply a DocuRAG service containing relevant operational runbooks.
DOCURAG_URL=
# Leave absent until you verify the current price for your selected model.
# INPUT_USD_PER_MILLION=
# OUTPUT_USD_PER_MILLION=
LANGFUSE_ENABLED=false
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
